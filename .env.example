# AgentOS Production Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# ============================================
# Application Configuration
# ============================================

# Flask environment (development/production)
FLASK_ENV=production

# Secret key for session management (generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))")
AGENTOS_SECRET_KEY=change-this-to-a-secure-random-key

# Logging level (DEBUG/INFO/WARNING/ERROR/CRITICAL)
AGENTOS_LOG_LEVEL=INFO

# Maximum number of concurrent agents
AGENTOS_MAX_AGENTS=100

# Command execution timeout (seconds)
AGENTOS_COMMAND_TIMEOUT=30

# Maximum steps per agent task
AGENTOS_MAX_STEPS=10

# ============================================
# LLM Provider API Keys
# At least one is required
# ============================================

# GitHub Models (recommended for getting started)
GIT_HUB_TOKEN=

# OpenAI
OPENAI_API_KEY=

# Anthropic Claude
CLAUDE_API_KEY=

# Google Gemini
GEMINI_API_KEY=

# Cohere
COHERE_API_KEY=

# ============================================
# Optional: Database Configuration
# ============================================

# SQLite is used by default at ~/.agentos/runtime.db
# For production with multiple instances, consider PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/agentos

# ============================================
# Optional: Monitoring & Observability
# ============================================

# Sentry DSN for error tracking
# SENTRY_DSN=

# Prometheus metrics port (default: included in main app)
# PROMETHEUS_PORT=9090

# ============================================
# Optional: Security
# ============================================

# Allowed hosts (comma-separated)
# ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com

# CORS origins (comma-separated)
# CORS_ORIGINS=https://your-frontend.com

# ============================================
# Optional: Performance
# ============================================

# Gunicorn workers (default: 4)
# GUNICORN_WORKERS=4

# Gunicorn timeout (default: 120)
# GUNICORN_TIMEOUT=120

# ============================================
# Optional: Docker Configuration
# ============================================

# Docker isolation (true/false)
# AGENTOS_ISOLATED=true

# Docker image for agent execution
# AGENTOS_DOCKER_IMAGE=agentos/runtime:latest
